<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" id="meta-theme-color" content="#fcfbf9">
    <link rel="manifest" href="./manifest.json">
    <link rel="apple-touch-icon" href="./icon-192.png">
    <title>Sherlock - Dégustation Avancée</title>
    
    <style>
        :root {
            color-scheme: light;
            --bg-color: #fcfbf9;
            --text-color: #2c2c2c;
            --text-muted: #666666;
            --primary: #722F37;
            --primary-light: rgba(114, 47, 55, 0.1);
            --secondary: #d4af37;
            --card-bg: #ffffff;
            --border: #e0e0e0;
            --tag-bg: #f5f5f5;
            --btn-text: #ffffff;
        }

        @media (prefers-color-scheme: dark) {
            :root:not([data-theme="light"]) {
                color-scheme: dark;
                --bg-color: #121212;
                --text-color: #e0e0e0;
                --text-muted: #999999;
                --primary: #9b404d;
                --primary-light: rgba(155, 64, 77, 0.15);
                --secondary: #d4af37;
                --card-bg: #1e1e1e;
                --border: #333333;
                --tag-bg: #2a2a2a;
            }
        }

        [data-theme="dark"] {
            color-scheme: dark;
            --bg-color: #121212;
            --text-color: #e0e0e0;
            --text-muted: #999999;
            --primary: #9b404d;
            --primary-light: rgba(155, 64, 77, 0.15);
            --secondary: #d4af37;
            --card-bg: #1e1e1e;
            --border: #333333;
            --tag-bg: #2a2a2a;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        
        html, body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            transition: background-color 0.3s, color 0.3s;
        }

        .container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            padding: 20px 4vw 100px 4vw;
        }

        h1 { text-align: center; color: var(--primary); font-size: clamp(1.4rem, 4vw, 2rem); margin: 0 0 0.5rem 0; }
        
        .status-badge {
            text-align: center;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
        }
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--tag-bg);
            border: 1px solid var(--border);
            padding: 4px 10px;
            border-radius: 15px;
            font-weight: 500;
        }
        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background-color: #888;
        }
        .status-dot.online { background-color: #2e7d32; }
        .status-dot.updating { background-color: var(--secondary); animation: pulse 1s infinite alternate; }
        .status-dot.offline { background-color: #c62828; }

        @keyframes pulse { from { opacity: 0.3; } to { opacity: 1; } }

        .theme-toggle-btn {
            background: var(--card-bg);
            border: 1px solid var(--border);
            color: var(--text-color);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            cursor: pointer;
            font-weight: 600;
        }

        h2 { font-size: clamp(1.2rem, 3vw, 1.4rem); color: var(--secondary); margin-bottom: 15px; border-bottom: 2px solid var(--primary-light); padding-bottom: 8px;}
        h3 { font-size: 0.85rem; margin: 20px 0 10px 0; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }

        .step { display: none; animation: fadeIn 0.35s ease-out; }
        .step.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .grid-2 { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 10px; 
            margin-bottom: 15px; 
        }

        .grid-3 { 
            display: grid; 
            grid-template-columns: repeat(3, 1fr) !important; 
            gap: 6px; 
            margin-bottom: 15px; 
        }

        .btn-radio {
            background: var(--card-bg);
            border: 2px solid var(--border);
            color: var(--text-color);
            padding: 12px 4px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 54px;
            line-height: 1.2;
        }

        .grid-3 .btn-radio {
            font-size: clamp(0.68rem, 2.4vw, 0.85rem);
            padding: 10px 2px;
            overflow-wrap: break-word;
            word-break: normal;
        }

        .btn-radio:active { transform: scale(0.97); }
        .btn-radio.selected {
            border-color: var(--primary);
            background: var(--primary-light);
            color: var(--primary);
        }

        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
        }
        .tag {
            background: var(--tag-bg);
            border: 1px solid var(--border);
            color: var(--text-color);
            padding: 9px 14px;
            border-radius: 20px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
        }
        .tag.active {
            background: var(--primary);
            color: var(--btn-text);
            border-color: var(--primary);
        }

        .nav-bar {
            position: fixed;
            bottom: 0; left: 0; right: 0;
            background: var(--card-bg);
            padding: 12px 4vw;
            box-shadow: 0 -4px 15px rgba(0,0,0,0.08);
            display: flex;
            justify-content: center;
            z-index: 1000;
            border-top: 1px solid var(--border);
        }
        .nav-inner {
            width: 100%;
            max-width: 800px;
            display: flex;
            gap: 10px;
        }
        
        .btn-nav {
            flex: 1;
            background: var(--primary);
            color: var(--btn-text);
            border: none;
            padding: 15px 15px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
        }
        .btn-nav:disabled { opacity: 0.4; cursor: not-allowed; }
        .btn-outline { background: transparent; border: 2px solid var(--text-muted); color: var(--text-muted); }

        .match-card {
            background: var(--card-bg);
            border: 2px solid var(--border);
            border-radius: 14px;
            padding: 20px;
            margin-bottom: 15px;
        }
        .match-card.winner {
            border-color: var(--secondary);
            background: linear-gradient(145deg, var(--card-bg) 0%, rgba(212, 175, 55, 0.08) 100%);
        }
        .match-title { 
            font-size: clamp(1.1rem, 3vw, 1.4rem); 
            color: var(--secondary); 
            font-weight: 800; 
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .match-score { 
            background: var(--secondary); 
            color: #000; 
            padding: 3px 10px; 
            border-radius: 12px; 
            font-size: 0.8rem; 
            font-weight: bold; 
        }
        .match-desc { font-size: 0.95rem; margin-bottom: 12px; line-height: 1.5; }
        .match-markers { font-size: 0.85rem; color: var(--text-muted); font-style: italic; background: var(--tag-bg); padding: 8px 12px; border-radius: 6px; }

    </style>
</head>
<body>

<div class="container">
    <h1>🔍 Sherlock Œnologie</h1>
    
    <div class="status-badge">
        <span class="status-pill">
            <span class="status-dot" id="status-dot"></span>
            <span id="app-version">v1.6.0</span> • <span id="cache-status">Vérification...</span>
        </span>
        <button class="theme-toggle-btn" onclick="toggleTheme()" id="theme-btn">Thème : Auto 🌓</button>
    </div>

    <div id="step-1" class="step active">
        <h2>1. L'Œil</h2>
        
        <h3>Couleur dominante</h3>
        <div class="grid-2" id="couleur-grid">
            <div class="btn-radio" onclick="selectRadio('couleur', 'blanc')">Blanc</div>
            <div class="btn-radio" onclick="selectRadio('couleur', 'rouge')">Rouge</div>
        </div>

        <h3>Intensité de la robe</h3>
        <div class="grid-3" id="opacite-grid">
            <div class="btn-radio" onclick="selectRadio('opacite', 'pale')">Pâle / Claire</div>
            <div class="btn-radio" onclick="selectRadio('opacite', 'moyenne')">Moyenne</div>
            <div class="btn-radio" onclick="selectRadio('opacite', 'profonde')">Opaque</div>
        </div>
        
        <h3>Larmes (Alcool)</h3>
        <div class="grid-2" id="larmes-grid">
            <div class="btn-radio" onclick="selectRadio('larmes', 'leger')">Fines (< 13°)</div>
            <div class="btn-radio" onclick="selectRadio('larmes', 'gras')">Épaisses (> 13.5°)</div>
        </div>
    </div>

    <div id="step-2" class="step">
        <h2>2. Le Nez (Arômes)</h2>
        <p style="font-size: 0.9em; color: var(--text-muted); margin-top: -5px;">Sélectionnez les marqueurs perçus au 1er et 2ème nez.</p>
        <div id="aromas-container"></div>
    </div>

    <div id="step-3" class="step">
        <h2>3. La Bouche</h2>
        
        <h3>Acidité (Salivation)</h3>
        <div class="grid-3" id="acidite-grid">
            <div class="btn-radio" onclick="selectRadio('acidite', 'basse')">Basse (Mou)</div>
            <div class="btn-radio" onclick="selectRadio('acidite', 'moyenne')">Équilibrée</div>
            <div class="btn-radio" onclick="selectRadio('acidite', 'haute')">Haute (Vif)</div>
        </div>

        <div id="bouche-rouge-only" style="display:none;">
            <h3>Tannins (Astringence)</h3>
            <div class="grid-3" id="tannins-grid">
                <div class="btn-radio" onclick="selectRadio('tannins', 'faibles')">Fondus</div>
                <div class="btn-radio" onclick="selectRadio('tannins', 'moyens')">Structurés</div>
                <div class="btn-radio" onclick="selectRadio('tannins', 'forts')">Asséchants</div>
            </div>
        </div>

        <div id="bouche-blanc-only" style="display:none;">
            <h3>Matière / Sucre</h3>
            <div class="grid-3" id="sucre-grid">
                <div class="btn-radio" onclick="selectRadio('sucre', 'sec')">Sec & Droit</div>
                <div class="btn-radio" onclick="selectRadio('sucre', 'gras')">Gras / Bois</div>
                <div class="btn-radio" onclick="selectRadio('sucre', 'doux')">Moelleux</div>
            </div>
        </div>
    </div>

    <div id="step-4" class="step">
        <h2>Le Verdict</h2>
        <div id="results-container"></div>
    </div>
</div>

<div class="nav-bar" id="nav-bar">
    <div class="nav-inner">
        <button class="btn-nav btn-outline" id="btn-prev" onclick="changeStep(-1)" style="display: none;">Précédent</button>
        <button class="btn-nav" id="btn-next" onclick="changeStep(1)" disabled>Nez ➔</button>
    </div>
</div>

<script>
    // --- GESTION DU THÈME ---
    function initTheme() {
        const savedTheme = localStorage.getItem('sherlock-theme');
        const html = document.documentElement;
        const btn = document.getElementById('theme-btn');
        
        if (savedTheme) {
            html.setAttribute('data-theme', savedTheme);
            btn.innerText = savedTheme === 'dark' ? 'Thème : Sombre 🌙' : 'Thème : Clair ☀️';
        }
        updateMetaThemeColor();
    }

    function toggleTheme() {
        const html = document.documentElement;
        const btn = document.getElementById('theme-btn');
        let current = html.getAttribute('data-theme');
        let nextTheme, btnText;

        if (!current) {
            nextTheme = 'dark';
            btnText = 'Thème : Sombre 🌙';
        } else if (current === 'dark') {
            nextTheme = 'light';
            btnText = 'Thème : Clair ☀️';
        } else {
            nextTheme = ''; 
            btnText = 'Thème : Auto 🌓';
        }

        if (nextTheme) {
            html.setAttribute('data-theme', nextTheme);
            localStorage.setItem('sherlock-theme', nextTheme);
        } else {
            html.removeAttribute('data-theme');
            localStorage.removeItem('sherlock-theme');
        }
        btn.innerText = btnText;
        updateMetaThemeColor();
    }

    function updateMetaThemeColor() {
        const metaTheme = document.getElementById('meta-theme-color');
        const html = document.documentElement;
        const currentTheme = html.getAttribute('data-theme');
        
        if (currentTheme === 'dark' || (!currentTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            metaTheme.setAttribute('content', '#121212');
        } else {
            metaTheme.setAttribute('content', '#fcfbf9');
        }
    }

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateMetaThemeColor);
    initTheme();

    // --- GESTION DU CACHE ET PWA (SERVICE WORKER) ---
    const APP_VERSION = "v1.6.0";
    function setCacheStatus(text, state) {
        const label = document.getElementById('cache-status');
        const dot = document.getElementById('status-dot');
        if (label) label.innerText = text;
        if (dot) dot.className = `status-dot ${state}`;
    }

    window.addEventListener('online', () => setCacheStatus('En ligne', 'online'));
    window.addEventListener('offline', () => setCacheStatus('Hors-ligne', 'offline'));

    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('./sw.js').then(registration => {
                setCacheStatus('En ligne', 'online');
                
                registration.addEventListener('updatefound', () => {
                    const worker = registration.installing;
                    worker.addEventListener('statechange', () => {
                        if (worker.state === 'installed' && navigator.serviceWorker.controller) {
                            window.location.reload();
                        }
                    });
                });
            }).catch(err => {
                setCacheStatus('En ligne', 'online');
            });
        });
    } else {
        setCacheStatus('En ligne', 'online');
    }

    // --- BASE DE DONNÉES EXPERTE ---
    const aromasLibrary = {
        blanc: [
            { cat: "Fruité", tags: ["Citron", "Pamplemousse", "Pomme verte", "Poire", "Coing", "Pêche", "Abricot", "Ananas", "Fruit de la passion", "Litchi"] },
            { cat: "Floral", tags: ["Acacia", "Chèvrefeuille", "Aubépine", "Rose", "Fleurs blanches", "Tilleul", "Violette (Condrieu)"] },
            { cat: "Végétal / Minéral", tags: ["Buis / Asperge", "Pierre à fusil", "Pétrole / Hydrocarbure", "Craie / Iode", "Fougère"] },
            { cat: "Élevage & Évolution", tags: ["Beurre / Brioche", "Noisette grillée", "Vanille", "Cire d'abeille", "Miel", "Laine mouillée", "Noix / Curry", "Amande amère"] }
        ],
        rouge: [
            { cat: "Fruité", tags: ["Cerise fraîche", "Cerise aigre / Griotte", "Framboise", "Fraise écrasée", "Fraise séchée", "Cassis", "Mûre / Myrtille", "Pruneau / Confiture", "Figue"] },
            { cat: "Floral & Végétal", tags: ["Pivoine", "Rose fanée", "Violette", "Poivron vert", "Feuille de thé", "Origan / Herbes séchées", "Rafle / Végétal", "Garrigue / Thym", "Menthol / Eucalyptus", "Olive / Tapenade"] },
            { cat: "Épices & Empyreumatique", tags: ["Poivre noir", "Poivre blanc", "Clou de girofle", "Réglisse", "Tabac / Cigare", "Cèdre / Bois", "Cacao / Chocolat", "Lardé / Fumé", "Goudron / Bitume", "Espresso / Café"] },
            { cat: "Animal & Évolution", tags: ["Cuir", "Sang / Viande crue", "Écurie (Bretts)", "Sous-bois / Champignon", "Truffe", "Terre humide"] }
        ]
    };

    const database = [
        // BLANCS MONOCÉPAGES
        { name: "Gros Manseng", color: "blanc", acidity: "haute", body: "doux", markers: ["Fruit de la passion", "Abricot", "Coing", "Miel", "Pêche"], desc: "Typique du Sud-Ouest (Côtes de Gascogne, Jurançon sec ou moelleux). Une acidité vive et structurée combinée à une explosion de fruits exotiques et de fruits de la passion." },
        { name: "Chenin Blanc (Évolué)", color: "blanc", acidity: "haute", body: "sec", markers: ["Coing", "Pomme verte", "Cire d'abeille", "Laine mouillée", "Miel", "Craie / Iode"], desc: "Cire d'abeille et laine humide associées à une forte acidité signent un grand Chenin de Loire (Savennières, Vouvray)." },
        { name: "Sémillon (Évolué)", color: "blanc", acidity: "basse", body: "gras", markers: ["Cire d'abeille", "Miel", "Abricot", "Noisette grillée", "Beurre / Brioche"], desc: "Note de cire avec acidité basse et matière grasse : typique du Sémillon évolué." },
        { name: "Riesling", color: "blanc", acidity: "haute", body: "sec", markers: ["Citron", "Pamplemousse", "Pétrole / Hydrocarbure", "Fleurs blanches", "Pierre à fusil"], desc: "Tension vivace et note de pétrole (TDN) après quelques années de garde (Alsace, Allemagne)." },
        { name: "Sauvignon Blanc", color: "blanc", acidity: "haute", body: "sec", markers: ["Citron", "Pamplemousse", "Buis / Asperge", "Pierre à fusil", "Fougère"], desc: "Profil végétal et agrumes. Pierre à fusil pour Sancerre/Pouilly-Fumé." },
        { name: "Chardonnay (Boisé)", color: "blanc", acidity: "moyenne", body: "gras", markers: ["Pomme verte", "Beurre / Brioche", "Noisette grillée", "Vanille", "Fleurs blanches"], desc: "Fût et fermentation malolactique apportent beurre, brioche et gras (Meursault, Saint-Véran)." },
        { name: "Viognier", color: "blanc", acidity: "basse", body: "gras", markers: ["Abricot", "Pêche", "Violette (Condrieu)", "Miel", "Amande amère"], desc: "Nez généreux sur l'abricot et la violette, texture ronde (Condrieu)." },
        { name: "Gewurztraminer", color: "blanc", acidity: "basse", body: "doux", markers: ["Litchi", "Rose", "Clou de girofle"], desc: "Profil exotique très parfumé avec une pointe de sucre résiduel." },
        { name: "Vin Jaune / Oxydatif", color: "blanc", acidity: "haute", body: "sec", markers: ["Noix / Curry", "Pomme verte", "Amande amère"], desc: "Arômes intenses de noix et curry issus de l'élevage sous voile (Savagnin du Jura)." },

        // BLANCS ASSEMBLAGE
        { name: "Assemblage Bordeaux Blanc", color: "blanc", acidity: "moyenne", body: "gras", markers: ["Citron", "Pamplemousse", "Beurre / Brioche", "Noisette grillée", "Cire d'abeille", "Pêche"], desc: "Alliance classique Sauvignon/Sémillon (Pessac-Léognan, Graves). La vivacité agrumes du Sauvignon est enrobée par le gras, la cire et l'élevage sous bois du Sémillon." },
        
        // ROUGES MONOCÉPAGES
        { name: "Nebbiolo", color: "rouge", opacity: "pale", tannins: "forts", acidity: "haute", markers: ["Rose fanée", "Goudron / Bitume", "Cerise aigre / Griotte", "Cuir", "Réglisse", "Terre humide"], desc: "Piège absolu à l'aveugle : robe claire et orangée mais acidité haute et tannins massifs (Barolo, Barbaresco)." },
        { name: "Sangiovese", color: "rouge", opacity: "moyenne", tannins: "forts", acidity: "haute", markers: ["Cerise aigre / Griotte", "Feuille de thé", "Origan / Herbes séchées", "Cuir", "Poivre noir"], desc: "Haute acidité, tannins fermes, griotte, feuille de thé et herbes séchées (Chianti Classico, Brunello)." },
        { name: "Tempranillo", color: "rouge", opacity: "profonde", tannins: "moyens", acidity: "moyenne", markers: ["Fraise séchée", "Tabac / Cigare", "Cuir", "Vanille", "Espresso / Café", "Pruneau / Confiture"], desc: "Fruits séchés, cuir et notes boisées douces (vanille, café, tabac) issues de l'élevage (Rioja, Ribera del Duero)." },
        { name: "Pinot Noir", color: "rouge", opacity: "pale", tannins: "faibles", acidity: "haute", markers: ["Cerise fraîche", "Framboise", "Pivoine", "Sous-bois / Champignon", "Terre humide"], desc: "Robe claire, acidité fraîche, tannins fins. Notes de pivoine et sous-bois." },
        { name: "Cabernet Sauvignon", color: "rouge", opacity: "profonde", tannins: "forts", acidity: "haute", markers: ["Cassis", "Mûre / Myrtille", "Poivron vert", "Tabac / Cigare", "Espresso / Café", "Menthol / Eucalyptus", "Cèdre / Bois"], desc: "Poivron, cèdre et boîte à cigare avec une structure tannique affirmée." },
        { name: "Cabernet Franc", color: "rouge", opacity: "moyenne", tannins: "moyens", acidity: "haute", markers: ["Framboise", "Poivron vert", "Rafle / Végétal", "Crayon/Graphite"], desc: "Notes végétales et de graphite fraîches (Chinon, Saumur-Champigny)." },
        { name: "Syrah (Rhône Nord)", color: "rouge", opacity: "profonde", tannins: "moyens", acidity: "haute", markers: ["Poivre noir", "Violette", "Lardé / Fumé", "Olive / Tapenade", "Sang / Viande crue"], desc: "Poivre noir, lardé/fumé et violette (Côte-Rôtie, Cornas)." },
        { name: "Grenache", color: "rouge", opacity: "moyenne", tannins: "moyens", acidity: "basse", markers: ["Fraise écrasée", "Pruneau / Confiture", "Figue", "Garrigue / Thym", "Poivre blanc"], desc: "Chaleureux, généreux en alcool avec arômes de fruits mûrs et garrigue." },
        { name: "Merlot", color: "rouge", opacity: "profonde", tannins: "moyens", acidity: "moyenne", markers: ["Cerise fraîche", "Pruneau / Confiture", "Cacao / Chocolat", "Sous-bois / Champignon", "Truffe"], desc: "Rond et velouté, évoluant vers le cacao et la truffe." },
        { name: "Mourvèdre", color: "rouge", opacity: "profonde", tannins: "forts", acidity: "moyenne", markers: ["Mûre / Myrtille", "Cuir", "Sang / Viande crue", "Écurie (Bretts)", "Terre humide"], desc: "Caractère sauvage, tannique et notes animales (Bandol)." },
        { name: "Gamay", color: "rouge", opacity: "pale", tannins: "faibles", acidity: "haute", markers: ["Cerise fraîche", "Fraise écrasée", "Pivoine", "Banane/Bonbon (Macération)"], desc: "Fruité, léger et croquant (Macération carbonique du Beaujolais)." },

        // ROUGES ASSEMBLAGE
        { name: "Assemblage GSM (Rhône Méridional)", color: "rouge", opacity: "profonde", tannins: "moyens", acidity: "moyenne", markers: ["Garrigue / Thym", "Fraise écrasée", "Poivre noir", "Olive / Tapenade", "Pruneau / Confiture", "Cuir", "Figue"], desc: "Châteauneuf-du-Pape, Gigondas, Vacqueyras. La rondeur chaleureuse du Grenache s'allie aux épices et à la tapenade de la Syrah, structurées par le cuir et les tannins du Mourvèdre." },
        { name: "Assemblage Bordeaux Rive Gauche", color: "rouge", opacity: "profonde", tannins: "forts", acidity: "haute", markers: ["Cassis", "Poivron vert", "Cèdre / Bois", "Tabac / Cigare", "Cerise fraîche", "Menthol / Eucalyptus"], desc: "Médoc, Graves, Pauillac, Margaux (Dominante Cabernet Sauvignon + Merlot). Structure tannique puissante, cassis dense, boîte à cigare et fermeté." },
        { name: "Assemblage Bordeaux Rive Droite", color: "rouge", opacity: "profonde", tannins: "moyens", acidity: "moyenne", markers: ["Cerise fraîche", "Cacao / Chocolat", "Pruneau / Confiture", "Truffe", "Poivron vert", "Sous-bois / Champignon"], desc: "Saint-Émilion, Pomerol (Dominante Merlot + Cabernet Franc). Bouche ample, veloutée et charnue sur les fruits noirs, la truffe et le cacao avec une touche de graphite." }
    ];

    let currentStep = 1;
    let state = {
        couleur: null, opacite: null, larmes: null,
        aromas: new Set(),
        acidite: null, tannins: null, sucre: null
    };

    function selectRadio(category, value) {
        state[category] = value;
        const grid = document.getElementById(`${category}-grid`);
        Array.from(grid.children).forEach(btn => btn.classList.remove('selected'));
        event.currentTarget.classList.add('selected');

        if (category === 'couleur') {
            document.getElementById('bouche-rouge-only').style.display = (value === 'rouge') ? 'block' : 'none';
            document.getElementById('bouche-blanc-only').style.display = (value === 'blanc') ? 'block' : 'none';
            generateAromaTags(value);
            state.aromas.clear();
        }
        checkStepCompletion();
    }

    function toggleTag(tagValue, element) {
        if (state.aromas.has(tagValue)) {
            state.aromas.delete(tagValue);
            element.classList.remove('active');
        } else {
            state.aromas.add(tagValue);
            element.classList.add('active');
        }
        checkStepCompletion();
    }

    function generateAromaTags(color) {
        const container = document.getElementById('aromas-container');
        container.innerHTML = '';
        const data = aromasLibrary[color];
        
        data.forEach(group => {
            const h3 = document.createElement('h3');
            h3.innerText = group.cat;
            container.appendChild(h3);
            
            const tagsDiv = document.createElement('div');
            tagsDiv.className = 'tags-container';
            
            group.tags.forEach(tag => {
                const btn = document.createElement('div');
                btn.className = 'tag';
                btn.innerText = tag;
                btn.onclick = (e) => toggleTag(tag, e.target);
                tagsDiv.appendChild(btn);
            });
            container.appendChild(tagsDiv);
        });
    }

    function changeStep(dir) {
        if (dir === 1 && currentStep === 3) {
            calculateVerdict();
        }
        
        document.getElementById(`step-${currentStep}`).classList.remove('active');
        currentStep += dir;
        document.getElementById(`step-${currentStep}`).classList.add('active');
        
        document.getElementById('btn-prev').style.display = (currentStep === 1) ? 'none' : 'block';
        
        const btnNext = document.getElementById('btn-next');
        if (currentStep === 1) btnNext.innerText = "Nez ➔";
        else if (currentStep === 2) btnNext.innerText = "Bouche ➔";
        else if (currentStep === 3) btnNext.innerText = "Verdict ➔";
        else if (currentStep === 4) {
            btnNext.innerText = "Nouvelle Enquête ↺";
            btnNext.onclick = () => location.reload();
            document.getElementById('btn-prev').style.display = 'none';
        }
        
        if(currentStep < 4) btnNext.onclick = () => changeStep(1);
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
        checkStepCompletion();
    }

    function checkStepCompletion() {
        const btnNext = document.getElementById('btn-next');
        let isValid = false;
        
        if (currentStep === 1) isValid = (state.couleur && state.opacite && state.larmes);
        else if (currentStep === 2) isValid = (state.aromas.size > 0);
        else if (currentStep === 3) {
            if (state.couleur === 'rouge') isValid = (state.acidite && state.tannins);
            else isValid = (state.acidite && state.sucre);
        }
        else if (currentStep === 4) isValid = true;
        
        btnNext.disabled = !isValid;
    }

    function calculateVerdict() {
        let results = [];
        const has = (tag) => state.aromas.has(tag);
        
        database.forEach(cepage => {
            if (cepage.color !== state.couleur) return;
            
            let score = 0;
            let matchedMarkers = [];

            if (cepage.acidity === state.acidite) score += 1;
            if (state.couleur === 'rouge' && cepage.tannins === state.tannins) score += 1;
            if (state.couleur === 'rouge' && cepage.opacity === state.opacite) score += 1;
            if (state.couleur === 'blanc' && cepage.body === state.sucre) score += 1;

            state.aromas.forEach(tag => {
                if (cepage.markers.includes(tag)) {
                    score += 3;
                    matchedMarkers.push(tag);
                }
            });

            // Killer Combos Monocépages
            const killerCombos = {
                "Pétrole / Hydrocarbure": "Riesling",
                "Cire d'abeille": ["Chenin Blanc (Évolué)", "Sémillon (Évolué)", "Assemblage Bordeaux Blanc"],
                "Poivron vert": ["Cabernet Sauvignon", "Cabernet Franc", "Assemblage Bordeaux Rive Gauche", "Assemblage Bordeaux Rive Droite"],
                "Lardé / Fumé": "Syrah (Rhône Nord)",
                "Banane/Bonbon (Macération)": "Gamay",
                "Noix / Curry": "Vin Jaune / Oxydatif",
                "Rose fanée": "Nebbiolo",
                "Goudron / Bitume": "Nebbiolo",
                "Feuille de thé": "Sangiovese",
                "Origan / Herbes séchées": "Sangiovese",
                "Fraise séchée": "Tempranillo",
                "Fruit de la passion": "Gros Manseng"
            };

            state.aromas.forEach(tag => {
                if (killerCombos[tag]) {
                    if (killerCombos[tag] === cepage.name || (Array.isArray(killerCombos[tag]) && killerCombos[tag].includes(cepage.name))) {
                        score += 6; 
                    } else {
                        score -= 2; 
                    }
                }
            });

            // COMBOS SPÉCIFIQUES POUR ASSEMBLAGES
            if (state.couleur === 'rouge') {
                if (has("Garrigue / Thym") && (has("Poivre noir") || has("Olive / Tapenade")) && (has("Fraise écrasée") || has("Cuir"))) {
                    if (cepage.name === "Assemblage GSM (Rhône Méridional)") score += 8;
                }
                if (has("Cassis") && has("Poivron vert") && (has("Cèdre / Bois") || has("Tabac / Cigare"))) {
                    if (cepage.name === "Assemblage Bordeaux Rive Gauche") score += 8;
                }
                if (has("Cacao / Chocolat") && (has("Cerise fraîche") || has("Pruneau / Confiture")) && (has("Truffe") || has("Poivron vert"))) {
                    if (cepage.name === "Assemblage Bordeaux Rive Droite") score += 8;
                }
            } else {
                if ((has("Citron") || has("Pamplemousse")) && has("Beurre / Brioche") && (has("Cire d'abeille") || has("Noisette grillée"))) {
                    if (cepage.name === "Assemblage Bordeaux Blanc") score += 8;
                }
            }

            if (score > 0) results.push({ ...cepage, score, matchedMarkers });
        });

        results.sort((a, b) => b.score - a.score);
        renderResults(results);
    }

    function renderResults(results) {
        const container = document.getElementById('results-container');
        container.innerHTML = '';

        if (results.length === 0) {
            container.innerHTML = '<p>Ce vin est un OVNI ! Les marqueurs sélectionnés s\'opposent. Essayez de relancer la dégustation.</p>';
            return;
        }
        
        results.slice(0, 3).forEach((res, index) => {
            const card = document.createElement('div');
            card.className = 'match-card';
            if (index === 0) card.classList.add('winner');
            
            card.innerHTML = `
                <div class="match-title">
                    <span>#${index + 1} - ${res.name}</span>
                    <span class="match-score">${res.score} pts</span>
                </div>
                <p class="match-desc">${res.desc}</p>
                <div class="match-markers">✔️ Marqueurs trouvés : <br> ${res.matchedMarkers.length > 0 ? res.matchedMarkers.join(', ') : 'Structure uniquement'}</div>
            `;
            container.appendChild(card);
        });
    }
</script>
</body>
</html>
